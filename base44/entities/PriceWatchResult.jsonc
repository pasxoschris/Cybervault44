{
  "name": "PriceWatchResult",
  "type": "object",
  "properties": {
    "watch_item_id": {
      "type": "string",
      "description": "ID \u03c4\u03bf\u03c5 PriceWatchItem"
    },
    "watch_item_name": {
      "type": "string",
      "description": "\u038c\u03bd\u03bf\u03bc\u03b1 \u03b1\u03bd\u03c4\u03b1\u03bb\u03bb\u03b1\u03ba\u03c4\u03b9\u03ba\u03bf\u03cd (snapshot)"
    },
    "retail_price": {
      "type": "number",
      "description": "Retail \u03c4\u03b9\u03bc\u03ae \u03c0\u03bf\u03c5 \u03b2\u03c1\u03ad\u03b8\u03b7\u03ba\u03b5 (EUR)"
    },
    "source_url": {
      "type": "string",
      "description": "URL \u03c0\u03b7\u03b3\u03ae\u03c2"
    },
    "source_name": {
      "type": "string",
      "description": "\u038c\u03bd\u03bf\u03bc\u03b1 \u03b9\u03c3\u03c4\u03bf\u03c3\u03b5\u03bb\u03af\u03b4\u03b1\u03c2/\u03c0\u03b7\u03b3\u03ae\u03c2"
    },
    "reseller_price": {
      "type": "number",
      "description": "\u03a4\u03c1\u03ad\u03c7\u03bf\u03c5\u03c3\u03b1 reseller \u03c4\u03b9\u03bc\u03ae (snapshot)"
    },
    "price_difference": {
      "type": "number",
      "description": "\u0394\u03b9\u03b1\u03c6\u03bf\u03c1\u03ac retail - reseller (EUR)"
    },
    "price_difference_pct": {
      "type": "number",
      "description": "\u0394\u03b9\u03b1\u03c6\u03bf\u03c1\u03ac %"
    },
    "checked_at": {
      "type": "string",
      "description": "\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1/\u03ce\u03c1\u03b1 \u03b5\u03bb\u03ad\u03b3\u03c7\u03bf\u03c5"
    },
    "notes": {
      "type": "string",
      "description": "\u03a3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2/\u03b5\u03c0\u03b9\u03c0\u03bb\u03ad\u03bf\u03bd \u03c0\u03bb\u03b7\u03c1\u03bf\u03c6\u03bf\u03c1\u03af\u03b5\u03c2"
    }
  },
  "required": [
    "watch_item_name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}