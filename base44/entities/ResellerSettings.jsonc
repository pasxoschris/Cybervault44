{
  "name": "ResellerSettings",
  "properties": {
    "company_address": {
      "description": "\u0394\u03b9\u03b5\u03cd\u03b8\u03c5\u03bd\u03c3\u03b7",
      "type": "string"
    },
    "company_name": {
      "description": "\u0395\u03c0\u03c9\u03bd\u03c5\u03bc\u03af\u03b1 \u03b5\u03c4\u03b1\u03b9\u03c1\u03b5\u03af\u03b1\u03c2",
      "type": "string"
    },
    "company_vat_number": {
      "description": "\u0391\u03a6\u039c",
      "type": "string"
    },
    "default_email_body": {
      "description": "\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf \u03c3\u03ce\u03bc\u03b1 email",
      "type": "string"
    },
    "default_email_subject": {
      "description": "\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf \u03b8\u03ad\u03bc\u03b1 email",
      "type": "string"
    },
    "default_terms": {
      "description": "\u038c\u03c1\u03bf\u03b9 & \u03a0\u03c1\u03bf\u03cb\u03c0\u03bf\u03b8\u03ad\u03c3\u03b5\u03b9\u03c2",
      "type": "string"
    },
    "default_vat_rate": {
      "default": 24,
      "description": "\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03bf\u03c2 \u03a6\u03a0\u0391 %",
      "type": "number"
    },
    "description": {
      "description": "\u03a0\u03c1\u03bf\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03ae \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae (\u03ad\u03c9\u03c2 1000 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03ae\u03c1\u03b5\u03c2)",
      "type": "string"
    },
    "offer_validity_days": {
      "default": 30,
      "description": "\u0399\u03c3\u03c7\u03cd\u03c2 \u03c0\u03c1\u03bf\u03c3\u03c6\u03bf\u03c1\u03ac\u03c2 (\u03b7\u03bc\u03ad\u03c1\u03b5\u03c2)",
      "type": "number"
    },
    "public_email": {
      "description": "Email \u03b5\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03af\u03b1\u03c2",
      "type": "string"
    },
    "public_phone": {
      "description": "\u03a4\u03b7\u03bb\u03ad\u03c6\u03c9\u03bd\u03bf",
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}