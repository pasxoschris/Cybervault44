{
  "name": "ResellerSettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Επωνυμία εταιρείας"
    },
    "company_address": {
      "type": "string",
      "description": "Διεύθυνση"
    },
    "company_vat_number": {
      "type": "string",
      "description": "ΑΦΜ"
    },
    "public_email": {
      "type": "string",
      "description": "Email επικοινωνίας"
    },
    "public_phone": {
      "type": "string",
      "description": "Τηλέφωνο"
    },
    "offer_validity_days": {
      "type": "number",
      "default": 30,
      "description": "Ισχύς προσφοράς (ημέρες)"
    },
    "default_vat_rate": {
      "type": "number",
      "default": 24,
      "description": "Προεπιλεγμένος ΦΠΑ %"
    },
    "default_email_subject": {
      "type": "string",
      "description": "Προεπιλεγμένο θέμα email"
    },
    "default_email_body": {
      "type": "string",
      "description": "Προεπιλεγμένο σώμα email"
    },
    "default_terms": {
      "type": "string",
      "description": "Όροι & Προϋποθέσεις"
    },
    "description": {
      "type": "string",
      "description": "Προαιρετική περιγραφή (έως 1000 χαρακτήρες)"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}
