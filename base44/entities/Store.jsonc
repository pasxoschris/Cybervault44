{
  "name": "Store",
  "type": "object",
  "properties": {
    "vat_number": {
      "type": "string",
      "description": "\u0391\u03a6\u039c \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 (\u03bc\u03cc\u03bd\u03bf \u03b1\u03c1\u03b9\u03b8\u03bc\u03bf\u03af, 9 \u03c8\u03b7\u03c6\u03af\u03b1)"
    },
    "business_name": {
      "type": "string",
      "description": "\u0395\u03c0\u03c9\u03bd\u03c5\u03bc\u03af\u03b1"
    },
    "trade_name": {
      "type": "string",
      "description": "\u0394\u03b9\u03b1\u03ba\u03c1\u03b9\u03c4\u03b9\u03ba\u03cc\u03c2 \u03a4\u03af\u03c4\u03bb\u03bf\u03c2"
    },
    "store_name": {
      "type": "string",
      "description": "\u038c\u03bd\u03bf\u03bc\u03b1 \u039a\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "prospect"
      ],
      "default": "active",
      "description": "\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "phone": {
      "type": "string",
      "description": "\u03a4\u03b7\u03bb\u03ad\u03c6\u03c9\u03bd\u03bf"
    },
    "mobile_phone": {
      "type": "string",
      "description": "\u039a\u03b9\u03bd\u03b7\u03c4\u03cc"
    },
    "address": {
      "type": "string",
      "description": "\u0394\u03b9\u03b5\u03cd\u03b8\u03c5\u03bd\u03c3\u03b7"
    },
    "city": {
      "type": "string",
      "description": "\u03a0\u03cc\u03bb\u03b7"
    },
    "postal_code": {
      "type": "string",
      "description": "\u03a4\u03b1\u03c7\u03c5\u03b4\u03c1\u03bf\u03bc\u03b9\u03ba\u03cc\u03c2 \u039a\u03ce\u03b4\u03b9\u03ba\u03b1\u03c2"
    },
    "contact_person": {
      "type": "string",
      "description": "\u03a5\u03c0\u03b5\u03cd\u03b8\u03c5\u03bd\u03bf\u03c2 \u0395\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03af\u03b1\u03c2"
    },
    "contact_position": {
      "type": "string",
      "description": "\u0398\u03ad\u03c3\u03b7 \u03a5\u03c0\u03b5\u03c5\u03b8\u03cd\u03bd\u03bf\u03c5"
    },
    "contact_email": {
      "type": "string",
      "description": "Email \u03a5\u03c0\u03b5\u03c5\u03b8\u03cd\u03bd\u03bf\u03c5"
    },
    "contact_mobile": {
      "type": "string",
      "description": "\u039a\u03b9\u03bd\u03b7\u03c4\u03cc \u03a5\u03c0\u03b5\u03c5\u03b8\u03cd\u03bd\u03bf\u03c5"
    },
    "spotlight_store_id": {
      "type": "string",
      "description": "Spotlight Store ID"
    },
    "spotlight_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "trial",
        "expired"
      ],
      "description": "\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 Spotlight"
    },
    "active_licenses": {
      "type": "number",
      "description": "\u0395\u03bd\u03b5\u03c1\u03b3\u03ad\u03c2 \u03ac\u03b4\u03b5\u03b9\u03b5\u03c2"
    },
    "installation_date": {
      "type": "string",
      "format": "date",
      "description": "\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1 \u03b5\u03b3\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2"
    },
    "academy_access": {
      "type": "boolean",
      "default": false,
      "description": "\u03a0\u03c1\u03cc\u03c3\u03b2\u03b1\u03c3\u03b7 \u03c3\u03c4\u03b7\u03bd Academy"
    },
    "training_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "suspended"
      ],
      "default": "not_started",
      "description": "\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03b5\u03ba\u03c0\u03b1\u03af\u03b4\u03b5\u03c5\u03c3\u03b7\u03c2"
    },
    "training_completed_at": {
      "type": "string",
      "format": "date",
      "description": "\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1 \u03bf\u03bb\u03bf\u03ba\u03bb\u03ae\u03c1\u03c9\u03c3\u03b7\u03c2 \u03b5\u03ba\u03c0\u03b1\u03af\u03b4\u03b5\u03c5\u03c3\u03b7\u03c2"
    },
    "training_notes": {
      "type": "string",
      "description": "\u03a3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2 \u03b5\u03ba\u03c0\u03b1\u03af\u03b4\u03b5\u03c5\u03c3\u03b7\u03c2"
    },
    "support_contract": {
      "type": "boolean",
      "default": false,
      "description": "\u03a3\u03cd\u03bc\u03b2\u03b1\u03c3\u03b7 \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7\u03c2"
    },
    "support_level": {
      "type": "string",
      "enum": [
        "none",
        "basic",
        "standard",
        "premium"
      ],
      "default": "none",
      "description": "\u0395\u03c0\u03af\u03c0\u03b5\u03b4\u03bf \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7\u03c2"
    },
    "support_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "ended"
      ],
      "default": "active",
      "description": "\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7\u03c2"
    },
    "support_notes": {
      "type": "string",
      "description": "\u03a3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2 \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7\u03c2"
    },
    "notes": {
      "type": "string",
      "description": "\u0395\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03ad\u03c2 \u03c3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2"
    },
    "tags": {
      "type": "string",
      "description": "\u0395\u03c4\u03b9\u03ba\u03ad\u03c4\u03b5\u03c2 (comma-separated)"
    },
    "updated_at": {
      "type": "string",
      "description": "\u03a4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b5\u03bd\u03b7\u03bc\u03ad\u03c1\u03c9\u03c3\u03b7"
    },
    "updated_by": {
      "type": "string",
      "description": "\u0395\u03bd\u03b7\u03bc\u03b5\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03b1\u03c0\u03cc"
    }
  },
  "required": [
    "vat_number",
    "business_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}