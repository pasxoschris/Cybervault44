{
  "name": "ResellerPricingItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Όνομα προϊόντος/υπηρεσίας"
    },
    "description": {
      "type": "string",
      "description": "Περιγραφή"
    },
    "category_id": {
      "type": "string",
      "description": "ID κατηγορίας (ResellerCategory)"
    },
    "unit_price": {
      "type": "number",
      "description": "Τιμή μονάδας (€)"
    },
    "vat_rate": {
      "type": "number",
      "default": 24,
      "description": "ΦΠΑ %"
    },
    "is_vat_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Απαλλαγή ΦΠΑ (π.χ. κινητά, laptop - άρθρο 45, Ν. 2859/2000)"
    },
    "default_discount_percentage": {
      "type": "number",
      "default": 0,
      "description": "Προεπιλεγμένη έκπτωση %"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Σειρά εμφάνισης (αύξουσα)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Ενεργό"
    },
    "source_url": {
      "type": "string",
      "description": "URL προϊόντος στο xpatit.gr για αυτόματη ανανέωση τιμής"
    },
    "previous_unit_price": {
      "type": "number",
      "description": "Τιμή πριν την τελευταία ανανέωση (€)"
    },
    "last_price_update": {
      "type": "string",
      "description": "Ημερομηνία τελευταίας ανανέωσης τιμής (ISO)"
    },
    "price_change_percentage": {
      "type": "number",
      "description": "Διαφορά τιμής από προηγούμενη φορά (%)"
    }
  },
  "required": [
    "name",
    "unit_price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
