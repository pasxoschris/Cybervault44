{
  "name": "ResellerPricingItem",
  "properties": {
    "category_id": {
      "description": "ID \u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1\u03c2 (ResellerCategory)",
      "type": "string"
    },
    "default_discount_percentage": {
      "default": 0,
      "description": "\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03b7 \u03ad\u03ba\u03c0\u03c4\u03c9\u03c3\u03b7 %",
      "type": "number"
    },
    "description": {
      "description": "\u03a0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae",
      "type": "string"
    },
    "display_order": {
      "default": 0,
      "description": "\u03a3\u03b5\u03b9\u03c1\u03ac \u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7\u03c2 (\u03b1\u03cd\u03be\u03bf\u03c5\u03c3\u03b1)",
      "type": "number"
    },
    "is_active": {
      "default": true,
      "description": "\u0395\u03bd\u03b5\u03c1\u03b3\u03cc",
      "type": "boolean"
    },
    "is_vat_exempt": {
      "default": false,
      "description": "\u0391\u03c0\u03b1\u03bb\u03bb\u03b1\u03b3\u03ae \u03a6\u03a0\u0391 (\u03c0.\u03c7. \u03ba\u03b9\u03bd\u03b7\u03c4\u03ac, laptop - \u03ac\u03c1\u03b8\u03c1\u03bf 45, \u039d. 2859/2000)",
      "type": "boolean"
    },
    "last_price_update": {
      "description": "\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1\u03c2 \u03b1\u03bd\u03b1\u03bd\u03ad\u03c9\u03c3\u03b7\u03c2 \u03c4\u03b9\u03bc\u03ae\u03c2 (ISO)",
      "type": "string"
    },
    "name": {
      "description": "\u038c\u03bd\u03bf\u03bc\u03b1 \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03bf\u03c2/\u03c5\u03c0\u03b7\u03c1\u03b5\u03c3\u03af\u03b1\u03c2",
      "type": "string"
    },
    "previous_unit_price": {
      "description": "\u03a4\u03b9\u03bc\u03ae \u03c0\u03c1\u03b9\u03bd \u03c4\u03b7\u03bd \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b1\u03bd\u03b1\u03bd\u03ad\u03c9\u03c3\u03b7 (\u20ac)",
      "type": "number"
    },
    "price_change_percentage": {
      "description": "\u0394\u03b9\u03b1\u03c6\u03bf\u03c1\u03ac \u03c4\u03b9\u03bc\u03ae\u03c2 \u03b1\u03c0\u03cc \u03c0\u03c1\u03bf\u03b7\u03b3\u03bf\u03cd\u03bc\u03b5\u03bd\u03b7 \u03c6\u03bf\u03c1\u03ac (%)",
      "type": "number"
    },
    "source_url": {
      "description": "URL \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03bf\u03c2 \u03c3\u03c4\u03bf xpatit.gr \u03b3\u03b9\u03b1 \u03b1\u03c5\u03c4\u03cc\u03bc\u03b1\u03c4\u03b7 \u03b1\u03bd\u03b1\u03bd\u03ad\u03c9\u03c3\u03b7 \u03c4\u03b9\u03bc\u03ae\u03c2",
      "type": "string"
    },
    "unit_price": {
      "description": "\u03a4\u03b9\u03bc\u03ae \u03bc\u03bf\u03bd\u03ac\u03b4\u03b1\u03c2 (\u20ac)",
      "type": "number"
    },
    "vat_rate": {
      "default": 24,
      "description": "\u03a6\u03a0\u0391 %",
      "type": "number"
    }
  },
  "required": [
    "name",
    "unit_price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}