{
  "name": "TicketSubcategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u038c\u03bd\u03bf\u03bc\u03b1 \u03c5\u03c0\u03bf\u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1\u03c2"
    },
    "category_id": {
      "type": "string",
      "description": "ID \u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1\u03c2 (TicketCategory)"
    },
    "description": {
      "type": "string",
      "description": "\u03a0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae"
    },
    "default_priority_id": {
      "type": "string",
      "description": "Default Priority ID"
    },
    "default_support_level_id": {
      "type": "string",
      "description": "Default SupportLevel ID"
    },
    "default_resolution_status_id": {
      "type": "string",
      "description": "Default ResolutionStatus ID"
    },
    "sla_minutes": {
      "type": "number",
      "description": "SLA \u03c3\u03b5 \u03bb\u03b5\u03c0\u03c4\u03ac"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}