{
  "name": "AllowedUserGuide",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email χρήστη με πρόσβαση στο SpotlightPOS Guide"
    },
    "name": {
      "type": "string",
      "description": "Όνομα (προαιρετικό)"
    },
    "store_id": {
      "type": "string",
      "description": "ID καταστήματος (Store) στο οποίο δουλεύει ο χρήστης"
    },
    "store_name": {
      "type": "string",
      "description": "Όνομα καταστήματος (snapshot)"
    },
    "modes": {
      "type": "string",
      "description": "Comma-separated εξουσιοδοτημένα mode IDs (service, cashier, maitre-service, maitre-mode, secure, backoffice). Κενό = όλα τα modes."
    },
    "description": {
      "type": "string",
      "description": "Προαιρετική περιγραφή (έως 1000 χαρακτήρες)"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
