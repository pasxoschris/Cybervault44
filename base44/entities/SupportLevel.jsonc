{
  "name": "SupportLevel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u038c\u03bd\u03bf\u03bc\u03b1 (Level 1, Level 2, Level 3)"
    },
    "level_number": {
      "type": "number",
      "description": "\u0391\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u03b5\u03c0\u03b9\u03c0\u03ad\u03b4\u03bf\u03c5"
    },
    "description": {
      "type": "string",
      "description": "\u03a0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae \u03b5\u03c0\u03b9\u03c0\u03ad\u03b4\u03bf\u03c5"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "level_number"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
