{
  "name": "KnowledgeArticle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Τίτλος άρθρου"
    },
    "role": {
      "type": "string",
      "enum": [
        "service",
        "maitre-service",
        "maitre-mode",
        "cashier",
        "secure",
        "backoffice",
        "general"
      ],
      "description": "Ρόλος που αφορά"
    },
    "category": {
      "type": "string",
      "description": "Κατηγορία (π.χ. παραγγελίες, πληρωμές, βάρδια)"
    },
    "lesson_title": {
      "type": "string",
      "description": "Τίτλος μαθήματος"
    },
    "lesson_url": {
      "type": "string",
      "description": "URL μαθήματος"
    },
    "keywords": {
      "type": "string",
      "description": "Λέξεις-κλειδιά για αναζήτηση (comma-separated)"
    },
    "content": {
      "type": "string",
      "description": "Περιεχόμενο άρθρου — βήματα, οδηγίες, σημειώσεις"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Ενεργό"
    }
  },
  "required": [
    "title",
    "role",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.guide_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
