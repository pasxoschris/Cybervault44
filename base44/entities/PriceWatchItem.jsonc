{
  "name": "PriceWatchItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u038c\u03bd\u03bf\u03bc\u03b1/\u03ba\u03c9\u03b4\u03b9\u03ba\u03cc\u03c2 \u03b1\u03bd\u03c4\u03b1\u03bb\u03bb\u03b1\u03ba\u03c4\u03b9\u03ba\u03bf\u03cd \u03c0\u03c1\u03bf\u03c2 \u03c0\u03b1\u03c1\u03b1\u03ba\u03bf\u03bb\u03bf\u03cd\u03b8\u03b7\u03c3\u03b7"
    },
    "search_query": {
      "type": "string",
      "description": "Keyword \u03ae URL \u03b1\u03bd\u03b1\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7\u03c2 \u03b3\u03b9\u03b1 retail \u03c4\u03b9\u03bc\u03ae"
    },
    "linked_pricing_item_id": {
      "type": "string",
      "description": "ID \u03c3\u03c7\u03b5\u03c4\u03b9\u03ba\u03bf\u03cd ResellerPricingItem \u03b3\u03b9\u03b1 \u03c3\u03cd\u03b3\u03ba\u03c1\u03b9\u03c3\u03b7 \u03c4\u03b9\u03bc\u03ce\u03bd"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0395\u03bd\u03b5\u03c1\u03b3\u03cc"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "\u03a3\u03b5\u03b9\u03c1\u03ac \u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7\u03c2"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}