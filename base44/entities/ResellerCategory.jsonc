{
  "name": "ResellerCategory",
  "properties": {
    "description": {
      "description": "\u03a0\u03c1\u03bf\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03ae \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae (\u03ad\u03c9\u03c2 1000 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03ae\u03c1\u03b5\u03c2)",
      "type": "string"
    },
    "display_order": {
      "default": 0,
      "description": "\u03a3\u03b5\u03b9\u03c1\u03ac \u03b5\u03bc\u03c6\u03ac\u03bd\u03b9\u03c3\u03b7\u03c2",
      "type": "number"
    },
    "is_active": {
      "default": true,
      "description": "\u0395\u03bd\u03b5\u03c1\u03b3\u03ae",
      "type": "boolean"
    },
    "name": {
      "description": "\u038c\u03bd\u03bf\u03bc\u03b1 \u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1\u03c2",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
