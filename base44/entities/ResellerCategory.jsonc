{
  "name": "ResellerCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Όνομα κατηγορίας"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Σειρά εμφάνισης"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Ενεργή"
    },
    "description": {
      "type": "string",
      "description": "Προαιρετική περιγραφή (έως 1000 χαρακτήρες)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
