{
  "name": "ResellerOffer",
  "properties": {
    "accepted_at": {
      "description": "Acceptance timestamp",
      "type": "string"
    },
    "accepted_pdf_url": {
      "description": "URL of accepted PDF with certificate",
      "type": "string"
    },
    "address": {
      "description": "\u0394\u03b9\u03b5\u03cd\u03b8\u03c5\u03bd\u03c3\u03b7",
      "type": "string"
    },
    "audit_log": {
      "description": "JSON array of {action, timestamp, actor, details}",
      "type": "string"
    },
    "company_legal_name": {
      "description": "\u0395\u03c0\u03c9\u03bd\u03c5\u03bc\u03af\u03b1",
      "type": "string"
    },
    "contact_person": {
      "description": "\u03a5\u03c0\u03b5\u03cd\u03b8\u03c5\u03bd\u03bf\u03c2",
      "type": "string"
    },
    "email": {
      "description": "Email",
      "type": "string"
    },
    "email_history": {
      "description": "JSON array of sent email log entries",
      "type": "string"
    },
    "expires_at": {
      "description": "\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1 \u03bb\u03ae\u03be\u03b7\u03c2",
      "format": "date",
      "type": "string"
    },
    "final_total": {
      "description": "\u03a4\u03b5\u03bb\u03b9\u03ba\u03cc \u03c3\u03cd\u03bd\u03bf\u03bb\u03bf",
      "type": "number"
    },
    "items": {
      "description": "JSON array of offer line items (snapshot)",
      "type": "string"
    },
    "last_sent_at": {
      "description": "\u03a4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b1 \u03b1\u03c0\u03bf\u03c3\u03c4\u03bf\u03bb\u03ae",
      "type": "string"
    },
    "last_sent_to": {
      "description": "\u03a3\u03c4\u03ac\u03bb\u03b8\u03b7\u03ba\u03b5 \u03c3\u03b5",
      "type": "string"
    },
    "notes": {
      "description": "\u03a3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2",
      "type": "string"
    },
    "otp_attempts": {
      "default": 0,
      "description": "Number of OTP verification attempts",
      "type": "number"
    },
    "otp_expires_at": {
      "description": "OTP expiry datetime",
      "type": "string"
    },
    "otp_hash": {
      "description": "SHA-256 hash of the OTP (never store plain text)",
      "type": "string"
    },
    "otp_last_sent_at": {
      "description": "Last OTP send datetime (for cooldown)",
      "type": "string"
    },
    "pdf_generated_at": {
      "description": "PDF generation datetime",
      "type": "string"
    },
    "pdf_url": {
      "description": "URL of generated PDF",
      "type": "string"
    },
    "phone": {
      "description": "\u03a4\u03b7\u03bb\u03ad\u03c6\u03c9\u03bd\u03bf",
      "type": "string"
    },
    "public_token": {
      "description": "Secure non-sequential public token for /offers/:publicToken URL",
      "type": "string"
    },
    "reference_number": {
      "description": "Unique offer reference, e.g. CYV-SPOT-20240605-001",
      "type": "string"
    },
    "rejected_at": {
      "description": "Rejection timestamp",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "description": "Offer status",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "accepted",
        "rejected",
        "expired"
      ],
      "type": "string"
    },
    "store_name": {
      "description": "\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1",
      "type": "string"
    },
    "subtotal_after_discount": {
      "description": "\u03a3\u03cd\u03bd\u03bf\u03bb\u03bf \u03bc\u03b5\u03c4\u03ac \u03ad\u03ba\u03c0\u03c4\u03c9\u03c3\u03b7",
      "type": "number"
    },
    "subtotal_before_discount": {
      "description": "\u03a3\u03cd\u03bd\u03bf\u03bb\u03bf \u03c0\u03c1\u03b9\u03bd \u03ad\u03ba\u03c0\u03c4\u03c9\u03c3\u03b7",
      "type": "number"
    },
    "total_discount": {
      "description": "\u03a3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03ae \u03ad\u03ba\u03c0\u03c4\u03c9\u03c3\u03b7",
      "type": "number"
    },
    "vat_amount": {
      "description": "\u03a0\u03bf\u03c3\u03cc \u03a6\u03a0\u0391",
      "type": "number"
    },
    "vat_number": {
      "description": "\u0391\u03a6\u039c",
      "type": "string"
    },
    "vat_rate": {
      "default": 24,
      "description": "\u03a6\u03a0\u0391 %",
      "type": "number"
    },
    "verification_details": {
      "description": "JSON: {method, verified_email, verified_at, ip, user_agent, otp_success, otp_attempts}",
      "type": "string"
    },
    "viewed_at": {
      "description": "First view timestamp",
      "type": "string"
    }
  },
  "required": [
    "company_legal_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}