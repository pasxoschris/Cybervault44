{
  "name": "ResellerOffer",
  "type": "object",
  "properties": {
    "reference_number": {
      "type": "string",
      "description": "Unique offer reference, e.g. CYV-SPOT-20240605-001"
    },
    "public_token": {
      "type": "string",
      "description": "Secure non-sequential public token for /offers/:publicToken URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "accepted",
        "rejected",
        "expired"
      ],
      "default": "draft",
      "description": "Offer status"
    },
    "store_name": {
      "type": "string",
      "description": "Κατάστημα"
    },
    "company_legal_name": {
      "type": "string",
      "description": "Επωνυμία"
    },
    "vat_number": {
      "type": "string",
      "description": "ΑΦΜ"
    },
    "address": {
      "type": "string",
      "description": "Διεύθυνση"
    },
    "contact_person": {
      "type": "string",
      "description": "Υπεύθυνος"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "phone": {
      "type": "string",
      "description": "Τηλέφωνο"
    },
    "notes": {
      "type": "string",
      "description": "Σημειώσεις"
    },
    "items": {
      "type": "string",
      "description": "JSON array of offer line items (snapshot)"
    },
    "subtotal_before_discount": {
      "type": "number",
      "description": "Σύνολο πριν έκπτωση"
    },
    "total_discount": {
      "type": "number",
      "description": "Συνολική έκπτωση"
    },
    "subtotal_after_discount": {
      "type": "number",
      "description": "Σύνολο μετά έκπτωση"
    },
    "vat_rate": {
      "type": "number",
      "default": 24,
      "description": "ΦΠΑ %"
    },
    "vat_amount": {
      "type": "number",
      "description": "Ποσό ΦΠΑ"
    },
    "final_total": {
      "type": "number",
      "description": "Τελικό σύνολο"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL of generated PDF"
    },
    "accepted_pdf_url": {
      "type": "string",
      "description": "URL of accepted PDF with certificate"
    },
    "pdf_generated_at": {
      "type": "string",
      "description": "PDF generation datetime"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Ημερομηνία λήξης"
    },
    "last_sent_at": {
      "type": "string",
      "description": "Τελευταία αποστολή"
    },
    "last_sent_to": {
      "type": "string",
      "description": "Στάλθηκε σε"
    },
    "email_history": {
      "type": "string",
      "description": "JSON array of sent email log entries"
    },
    "viewed_at": {
      "type": "string",
      "description": "First view timestamp"
    },
    "accepted_at": {
      "type": "string",
      "description": "Acceptance timestamp"
    },
    "rejected_at": {
      "type": "string",
      "description": "Rejection timestamp"
    },
    "otp_hash": {
      "type": "string",
      "description": "SHA-256 hash of the OTP (never store plain text)"
    },
    "otp_expires_at": {
      "type": "string",
      "description": "OTP expiry datetime"
    },
    "otp_attempts": {
      "type": "number",
      "default": 0,
      "description": "Number of OTP verification attempts"
    },
    "otp_last_sent_at": {
      "type": "string",
      "description": "Last OTP send datetime (for cooldown)"
    },
    "verification_details": {
      "type": "string",
      "description": "JSON: {method, verified_email, verified_at, ip, user_agent, otp_success, otp_attempts}"
    },
    "audit_log": {
      "type": "string",
      "description": "JSON array of {action, timestamp, actor, details}"
    }
  },
  "required": [
    "company_legal_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.reseller_access": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
