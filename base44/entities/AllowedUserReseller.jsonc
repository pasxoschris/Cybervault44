{
  "name": "AllowedUserReseller",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email χρήστη με πρόσβαση στο Reseller Console"
    },
    "name": {
      "type": "string",
      "description": "Όνομα (προαιρετικό)"
    },
    "description": {
      "type": "string",
      "description": "Προαιρετική περιγραφή (έως 1000 χαρακτήρες)"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
