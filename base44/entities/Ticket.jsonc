{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Ημερομηνία"
    },
    "time": {
      "type": "string",
      "description": "Ώρα"
    },
    "operator": {
      "type": "string",
      "description": "Χειριστής"
    },
    "store_id": {
      "type": "string",
      "description": "ID \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 (Store entity)"
    },
    "store": {
      "type": "string",
      "description": "\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1 (snapshot)"
    },
    "caller": {
      "type": "string",
      "description": "Ποιος κάλεσε"
    },
    "phone": {
      "type": "string",
      "description": "Τηλέφωνο"
    },
    "problem": {
      "type": "string",
      "description": "Πρόβλημα"
    },
    "resolved": {
      "type": "boolean",
      "default": false,
      "description": "Επιλύθηκε ή στάλθηκε στο ox.one support"
    },
    "notes": {
      "type": "string",
      "description": "Παρατηρήσεις"
    },
    "category_not_spotlight": {
      "type": "boolean",
      "default": false,
      "description": "ΔΕΝ ΑΦΟΡΟΥΣΕ ΤΗ SPOTLIGHT"
    },
    "category_printers": {
      "type": "boolean",
      "default": false,
      "description": "ΕΚΤΥΠΩΤΕΣ"
    },
    "category_settings": {
      "type": "boolean",
      "default": false,
      "description": "ΡΥΘΜΙΣΕΙΣ ΕΦΑΡΜΟΓΗΣ"
    },
    "category_pos": {
      "type": "boolean",
      "default": false,
      "description": "POS"
    },
    "category_pda": {
      "type": "boolean",
      "default": false,
      "description": "PDA"
    },
    "category_invoices": {
      "type": "boolean",
      "default": false,
      "description": "Τιμολόγια"
    }
  },
  "required": [
    "date",
    "store",
    "problem"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
