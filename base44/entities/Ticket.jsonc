{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1"
    },
    "time": {
      "type": "string",
      "description": "\u038f\u03c1\u03b1"
    },
    "operator": {
      "type": "string",
      "description": "\u03a7\u03b5\u03b9\u03c1\u03b9\u03c3\u03c4\u03ae\u03c2"
    },
    "store_id": {
      "type": "string",
      "description": "ID \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 (Store entity)"
    },
    "store": {
      "type": "string",
      "description": "\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1 (snapshot)"
    },
    "caller": {
      "type": "string",
      "description": "\u03a0\u03bf\u03b9\u03bf\u03c2 \u03ba\u03ac\u03bb\u03b5\u03c3\u03b5"
    },
    "phone": {
      "type": "string",
      "description": "\u03a4\u03b7\u03bb\u03ad\u03c6\u03c9\u03bd\u03bf"
    },
    "problem": {
      "type": "string",
      "description": "\u03a0\u03c1\u03cc\u03b2\u03bb\u03b7\u03bc\u03b1"
    },
    "resolved": {
      "type": "boolean",
      "default": false,
      "description": "\u0395\u03c0\u03b9\u03bb\u03cd\u03b8\u03b7\u03ba\u03b5 \u03ae \u03c3\u03c4\u03ac\u03bb\u03b8\u03b7\u03ba\u03b5 \u03c3\u03c4\u03bf ox.one support"
    },
    "notes": {
      "type": "string",
      "description": "\u03a0\u03b1\u03c1\u03b1\u03c4\u03b7\u03c1\u03ae\u03c3\u03b5\u03b9\u03c2"
    },
    "category_not_spotlight": {
      "type": "boolean",
      "default": false,
      "description": "\u0394\u0395\u039d \u0391\u03a6\u039f\u03a1\u039f\u03a5\u03a3\u0395 \u03a4\u0397 SPOTLIGHT"
    },
    "category_printers": {
      "type": "boolean",
      "default": false,
      "description": "\u0395\u039a\u03a4\u03a5\u03a0\u03a9\u03a4\u0395\u03a3"
    },
    "category_settings": {
      "type": "boolean",
      "default": false,
      "description": "\u03a1\u03a5\u0398\u039c\u0399\u03a3\u0395\u0399\u03a3 \u0395\u03a6\u0391\u03a1\u039c\u039f\u0393\u0397\u03a3"
    },
    "category_pos": {
      "type": "boolean",
      "default": false,
      "description": "POS"
    },
    "category_pda": {
      "type": "boolean",
      "default": false,
      "description": "PDA"
    },
    "category_invoices": {
      "type": "boolean",
      "default": false,
      "description": "\u03a4\u03b9\u03bc\u03bf\u03bb\u03cc\u03b3\u03b9\u03b1"
    }
  },
  "required": [
    "date",
    "store",
    "problem"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}