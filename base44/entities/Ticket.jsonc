{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1"
    },
    "time": {
      "type": "string",
      "description": "\u038f\u03c1\u03b1"
    },
    "operator": {
      "type": "string",
      "description": "\u03a7\u03b5\u03b9\u03c1\u03b9\u03c3\u03c4\u03ae\u03c2"
    },
    "store_id": {
      "type": "string",
      "description": "ID \u03ba\u03b1\u03c4\u03b1\u03c3\u03c4\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2 (Store entity)"
    },
    "store": {
      "type": "string",
      "description": "\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1 (snapshot)"
    },
    "caller": {
      "type": "string",
      "description": "\u03a0\u03bf\u03b9\u03bf\u03c2 \u03ba\u03ac\u03bb\u03b5\u03c3\u03b5"
    },
    "phone": {
      "type": "string",
      "description": "\u03a4\u03b7\u03bb\u03ad\u03c6\u03c9\u03bd\u03bf"
    },
    "ticket_type_id": {
      "type": "string",
      "description": "ID \u03c4\u03cd\u03c0\u03bf\u03c5 ticket (TicketType)"
    },
    "ticket_type": {
      "type": "string",
      "description": "\u03a4\u03cd\u03c0\u03bf\u03c2 ticket (snapshot)"
    },
    "category_id": {
      "type": "string",
      "description": "ID \u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1\u03c2 (TicketCategory)"
    },
    "category": {
      "type": "string",
      "description": "\u039a\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1 (snapshot)"
    },
    "subcategory_id": {
      "type": "string",
      "description": "ID \u03c5\u03c0\u03bf\u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1\u03c2 (TicketSubcategory)"
    },
    "subcategory": {
      "type": "string",
      "description": "\u03a5\u03c0\u03bf\u03ba\u03b1\u03c4\u03b7\u03b3\u03bf\u03c1\u03af\u03b1 (snapshot)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "description": "\u03a0\u03c1\u03bf\u03c4\u03b5\u03c1\u03b1\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1"
    },
    "support_level_id": {
      "type": "string",
      "description": "ID \u03b5\u03c0\u03b9\u03c0\u03ad\u03b4\u03bf\u03c5 \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7\u03c2 (SupportLevel)"
    },
    "support_level": {
      "type": "string",
      "description": "\u0395\u03c0\u03af\u03c0\u03b5\u03b4\u03bf \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7\u03c2 (snapshot)"
    },
    "resolution_status_id": {
      "type": "string",
      "description": "ID \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03b5\u03c0\u03af\u03bb\u03c5\u03c3\u03b7\u03c2 (ResolutionStatus)"
    },
    "resolution_status": {
      "type": "string",
      "description": "\u039a\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03b5\u03c0\u03af\u03bb\u03c5\u03c3\u03b7\u03c2 (snapshot)"
    },
    "escalated_to": {
      "type": "string",
      "description": "\u039a\u03bb\u03b9\u03bc\u03b1\u03ba\u03ce\u03b8\u03b7\u03ba\u03b5 \u03c3\u03b5"
    },
    "root_cause": {
      "type": "string",
      "description": "\u0391\u03b9\u03c4\u03af\u03b1 \u03c0\u03c1\u03bf\u03b2\u03bb\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2"
    },
    "problem": {
      "type": "string",
      "description": "\u03a0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae \u03c0\u03c1\u03bf\u03b2\u03bb\u03ae\u03bc\u03b1\u03c4\u03bf\u03c2"
    },
    "notes": {
      "type": "string",
      "description": "\u0395\u03bd\u03ad\u03c1\u03b3\u03b5\u03b9\u03b5\u03c2 \u03c0\u03bf\u03c5 \u03ad\u03b3\u03b9\u03bd\u03b1\u03bd"
    },
    "resolution_notes": {
      "type": "string",
      "description": "\u03a3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2 \u03b5\u03c0\u03af\u03bb\u03c5\u03c3\u03b7\u03c2"
    },
    "create_kb_article": {
      "type": "boolean",
      "default": false,
      "description": "\u0394\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03ac\u03c1\u03b8\u03c1\u03bf\u03c5 Knowledge Base"
    },
    "resolved": {
      "type": "boolean",
      "default": false,
      "description": "\u0395\u03c0\u03b9\u03bb\u03cd\u03b8\u03b7\u03ba\u03b5 (legacy)"
    }
  },
  "required": [
    "date",
    "store",
    "problem"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}